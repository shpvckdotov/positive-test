# Copy this file to .env and adjust values for local development

DATABASE_URL=postgresql+asyncpg://loguser:logpassword@localhost:5432/logclustering
DATABASE_URL_SYNC=postgresql://loguser:logpassword@localhost:5432/logclustering
MODEL_DIR=./models

# DBSCAN hyperparameters
DBSCAN_EPS=0.35
DBSCAN_MIN_SAMPLES=3
ANOMALY_THRESHOLD=0.6

# Log data paths (used by ml/train.py)
LINUX_LOG_PATH=./data/sample_logs/linux.log
WINDOWS_LOG_PATH=./data/sample_logs/windows.log
HDFS_LOG_PATH=./data/sample_logs/hdfs.log
